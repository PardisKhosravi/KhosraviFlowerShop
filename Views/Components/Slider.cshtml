@using KhosraviFlowerShop.Classes
@model IEnumerable<KhosraviFlowerShop.Models.Product>
<div class="news-slider border-radius">
    <div id="slider-one" class="owl-carousel">
        @foreach (var item in Model)
        {
            <!-- each item -->
            <div class="item">
                <img src="~/img/Products/@item.Image">
                <div class="left-side">
                    <h2> <a href="">@item.Title</a> </h2>
                    <p>
                        @item.ShortDescription
                    </p>
                    <span> <i class="fa fa-calendar"></i> انتشار : @item.CreateDate</span>
                </div>
                <div class="clearfix"></div>
            </div>
            <!-- end each item -->

        }
    </div>
    <a href="" class="news-archive"> <i class="icons icon-doc-1"></i> آرشیو کامل محصولات </a>
</div>